# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

DB_DSN=postgres://postgres:postgres@localhost:5432/ledger?sslmode=disable
DB_DSN_TEST=postgres://postgres:postgres@localhost:5432/ledger_test?sslmode=disable

GRPC_PORT=9090
HTTP_PORT=8080

AUDIT_MODE=async
AUDIT_HOOK_URL=

LOG_LEVEL=debug
COMPOSE_PROJECT_NAME=ledger